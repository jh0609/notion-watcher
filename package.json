{
  "name": "notion-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Watch a public Notion page once and send ntfy push notifications when it changes.",
  "main": "notion-watcher-once.js",
  "scripts": {
    "start": "node notion-watcher-once.js",
    "dry-run": "node notion-watcher-once.js --dry-run",
    "debug:cards": "node notion-watcher-once.js --debug-cards",
    "benchmark:details": "node notion-watcher-once.js --benchmark-details",
    "debug:detail": "node notion-watcher-once.js --debug-detail",
    "debug:transition": "node notion-watcher-once.js --debug-transition",
    "test:transition": "node notion-watcher-once.js --debug-transition",
    "benchmark:transition": "node notion-watcher-once.js --benchmark-transition",
    "analyze:card-detail": "node notion-watcher-once.js --analyze-card-detail",
    "check": "node --check notion-watcher-once.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.49.1"
  }
}
